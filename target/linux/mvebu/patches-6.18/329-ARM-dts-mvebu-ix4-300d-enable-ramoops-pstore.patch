From: Bob Sponge <myandroidiptvbox@gmail.com>
Subject: [PATCH] ARM: dts: mvebu: ix4-300d: reserve 512 KiB ramoops pstore buffer

Signed-off-by: Bob Sponge <myandroidiptvbox@gmail.com>
---
--- a/arch/arm/boot/dts/marvell/armada-xp-lenovo-ix4-300d.dts
+++ b/arch/arm/boot/dts/marvell/armada-xp-lenovo-ix4-300d.dts
@@ -27,6 +27,23 @@
 		reg = <0 0x00000000 0 0x20000000>; /* 512 MB */
 	};
 
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		ramoops@1ff80000 {
+			compatible = "ramoops";
+			reg = <0 0x1ff80000 0 0x80000>;
+			record-size = <0x20000>;
+			console-size = <0x20000>;
+			pmsg-size = <0x10000>;
+			ecc-size = <16>;
+		};
+	};
+
 	soc {
