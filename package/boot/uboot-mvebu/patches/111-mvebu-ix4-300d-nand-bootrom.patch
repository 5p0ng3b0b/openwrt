From: OpenWrt Maintainers <openwrt-devel@lists.openwrt.org>
Subject: [PATCH] tools: kwbimage: align NAND v0/v1 headers to 2048-byte pages

Marvell Armada XP BootROM 1.15 on the Lenovo Iomega ix4-300d requires
NAND kwbimage v1 headers to align both `headersz` and `srcaddr` to
2048-byte NAND page boundaries (`headersz == srcaddr`) with `nandpagesize`
set to 0x0 in the main header.

- Align `IBR_HDR_NAND_ID` header offsets to 2048 bytes instead of 256 bytes
- Set `headersz = *dataoff` in `image_create_v0` and `image_create_v1` for
  NAND boot images so `headersz` matches `srcaddr` and is checksummed in full
- Set `KWB_CFG_NAND_PAGE_SIZE = 0x0` in `arch/arm/mach-mvebu/Makefile`

--- a/tools/kwbimage.c	2026-11-18 13:43:12.186933171 +0000
+++ b/tools/kwbimage.c	2026-11-18 13:43:12.187115811 +0000
@@ -1016,7 +1016,7 @@
 	if (blockid == IBR_HDR_UART_ID)
 		return ALIGN(headersz, 128);
 	else if (blockid == IBR_HDR_NAND_ID)
-		return ALIGN(headersz, 256);
+		return ALIGN(headersz, 2048);
 	else if (blockid == IBR_HDR_SDIO_ID)
 		return ALIGN(headersz, 512);
 	else if (blockid == IBR_HDR_SATA_ID)
@@ -1054,6 +1054,8 @@
 	 */
 	headersz = image_headersz_v0(&has_ext);
 	*dataoff = image_headersz_align(headersz, image_get_bootfrom());
+	if (image_get_bootfrom() == IBR_HDR_NAND_ID)
+		headersz = *dataoff;
 
 	image = malloc(headersz);
 	if (!image) {
@@ -1496,6 +1498,8 @@
 	if (headersz == 0)
 		return NULL;
 	*dataoff = image_headersz_align(headersz, image_get_bootfrom());
+	if (image_get_bootfrom() == IBR_HDR_NAND_ID)
+		headersz = *dataoff;
 
 	image = malloc(headersz);
 	if (!image) {
--- a/arch/arm/mach-mvebu/Makefile	2026-11-18 13:43:12.187730298 +0000
+++ b/arch/arm/mach-mvebu/Makefile	2026-11-18 13:43:12.187759943 +0000
@@ -69,7 +69,7 @@
 
 ifneq ($(CONFIG_MVEBU_SPL_BOOT_DEVICE_NAND),)
 KWB_REPLACE += NAND_PAGE_SIZE NAND_BLKSZ NAND_BADBLK_LOCATION
-KWB_CFG_NAND_PAGE_SIZE = $(CONFIG_SYS_NAND_PAGE_SIZE)
+KWB_CFG_NAND_PAGE_SIZE = 0x0
 KWB_CFG_NAND_BLKSZ = $(CONFIG_SYS_NAND_BLOCK_SIZE)
 KWB_CFG_NAND_BADBLK_LOCATION = $(CONFIG_MVEBU_SPL_NAND_BADBLK_LOCATION)
 endif
