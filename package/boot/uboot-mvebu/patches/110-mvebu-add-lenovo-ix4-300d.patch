+	return 0;
+}
+
+static int do_ix4_patch_fdt(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+	ulong addr = argc > 1 ? hextoul(*(argv + 1), NULL) : 0x04000000;
+	struct legacy_img_hdr *hdr = (struct legacy_img_hdr *)addr;
+	u32 size, off, *cells;
+	void *fdt = NULL;
+	int node, len;
+
+	if (image_get_magic(hdr) != IH_MAGIC) {
+		printf("ix4_patch_fdt: invalid uImage magic at 0x%08lx\n", addr);
+		return CMD_RET_FAILURE;
+	}
+
+	size = image_get_size(hdr);
+	for (off = size & ~3U; off > (size > 0x10000 ? size - 0x10000 : 0); off -= 4) {
+		void *cand = (void *)(addr + sizeof(*hdr) + off);
+		if (fdt_magic(cand) == FDT_MAGIC && fdt_totalsize(cand) <= size - off) {
+			fdt = cand;
+			break;
+		}
+	}
+
+	if (!fdt) {
+		printf("ix4_patch_fdt: appended DTB not found\n");
+		return CMD_RET_FAILURE;
+	}
+
+	node = fdt_path_offset(fdt, "/soc");
+	if (node < 0)
+		return CMD_RET_FAILURE;
+
+	cells = (u32 *)fdt_getprop_w(fdt, node, "ranges", &len);
+	if (!cells || len < 16)
+		return CMD_RET_FAILURE;
+
+	if (fdt32_to_cpu(*(cells + 3)) == 0xd0000000) {
+		*(cells + 3) = cpu_to_fdt32(0xf1000000);
+		printf("ix4_patch_fdt: patched /soc/ranges (0xd0000000 -> 0xf1000000) at 0x%p\n", fdt);
+	}
+
+	return CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(
+	ix4_patch_fdt, 2, 0, do_ix4_patch_fdt,
+	"patch appended DTB /soc/ranges for U-Boot 2026.10",
+	"[uimage_addr]"
+);
+
+int board_init(void)
+{
+	mdelay(50);
+	/* Ungate PEX0 and PEX1 clocks (bits 5..8) without leaving PCIe BARs/windows active */
+	setbits_le32(0xf1018220, 0x3e0);
+	gd->bd->bi_boot_params = mvebu_sdram_bar(0) + 0x100;
+	return 0;
+}
+
+int board_late_init(void)
+{
+	pci_init();
+	return 0;
+}
