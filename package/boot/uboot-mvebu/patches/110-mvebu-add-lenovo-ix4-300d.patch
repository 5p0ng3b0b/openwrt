+};
+
+nand@d0000 {
+num-cs = <1>;
+marvell,nand-enable-arbiter;
+nand-ecc-strength = <4>;
+nand-ecc-step-size = <512>;
+};
+};
+
+pcie@82000000 {
+pcie@2,0 {
+status = "disabled";
+};
+};
+
+pcie@82000000 {
+pcie@2,0 {
+status = "disabled";
+};
+};
+};
+};
