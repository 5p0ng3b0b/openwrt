{
	"luci-app-volume-manager": {
		"description": "Grant access to Volume Manager ubus methods and fstab UCI",
		"read": {
			"ubus": {
				"volmgr": [
					"list",
					"info",
					"smart",
					"packages",
					"job_status",
					"volumes_status",
					"backup_list",
                                        "share_list"
				],
				"file": [
					"read",
					"stat"
				]
			},
			"uci": [
				"fstab"
			],
			"file": {
				"/tmp/volmgr.log": [
					"read"
				],
				"/proc/mounts": [
					"read"
				]
			}
		},
		"write": {
			"ubus": {
				"volmgr": [
					"create_part",
					"format_part",
					"resize_part",
					"move_part",
					"delete_part",
					"set_part_meta",
					"mount_action",
					"pkg_action",
					"raid_action",
					"luks_action",
					"lvm_action",
					"iscsi_action",
					"backup_save",
					"backup_run",
                                        "share_action"
				]
			},
			"uci": [
				"fstab"
			]
		}
	}
}
