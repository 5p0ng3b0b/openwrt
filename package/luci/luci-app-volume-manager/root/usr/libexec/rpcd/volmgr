#!/bin/sh
. /usr/share/libubox/jshn.sh

JOB_FILE="/tmp/volmgr-job.json"
LOG_FILE="/tmp/volmgr.log"

log_line() {
printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$LOG_FILE"
}

is_safe_dev() {
dev="$1"
[ -b "$dev" ] || return 1
bn=$(basename "$dev")
case "$bn" in
mtd*|ubi*|loop*|ram*|zram*|mmcblk0*) return 1 ;;
sd[a-z]|sd[a-z][0-9]*|nvme[0-9]*n[0-9]*|mmcblk[1-9]*|vd[a-z]*|md[0-9]*) ;;
*) return 1 ;;
esac
if awk -v d="$dev" '$1==d && ($2=="/" || $2=="/overlay" || $2=="/rom") {found=1} END{exit !found}' /proc/mounts 2>/dev/null; then
return 1
fi
return 0
}

write_job() {
state="$1"; pct="$2"; step="$3"; start_ts="$4"; eta="$5"; msg="$6"
now=$(date +%s)
elapsed=$((now - start_ts))
json_init
json_add_string "state" "$state"
json_add_int "pct" "$pct"
json_add_string "step" "$step"
json_add_int "elapsed" "$elapsed"
json_add_int "eta" "$eta"
json_add_string "message" "$msg"
json_dump > "$JOB_FILE"
}

part_path_for() {
disk="$1"; num="$2"
case "$(basename "$disk")" in
*[0-9]) echo "${disk}p${num}" ;;
*) echo "${disk}${num}" ;;
esac
}

gpt_type_guid() {
case "$1" in
linux|ext4|ext3|ext2|btrfs|f2fs) echo "0FC63DAF-8483-4772-8E79-3D69D8477DE4" ;;
swap) echo "0657FD6D-A4AB-43C4-84E5-0933C84B4F4F" ;;
raid) echo "A19D880F-05FC-4D3B-A006-743F0F84911E" ;;
lvm) echo "E6D6D379-F507-44C2-A23C-238F2A3DF928" ;;
esp|efi) echo "C12A7328-F81F-11D2-BA4B-00A0C93EC93B" ;;
msftdata|ntfs|exfat|vfat) echo "EBD0A0A2-B9E5-4433-87C0-68B6B72699C7" ;;
diag|recovery) echo "DE94BBA4-06D1-4D40-A16A-BFD50179D6AC" ;;
*) echo "0FC63DAF-8483-4772-8E79-3D69D8477DE4" ;;
esac
}

mbr_type_hex() {
case "$1" in
linux|ext4|ext3|ext2|btrfs|f2fs) echo "83" ;;
swap) echo "82" ;;
raid) echo "fd" ;;
lvm) echo "8e" ;;
esp|efi) echo "ef" ;;
msftdata|ntfs|exfat) echo "07" ;;
vfat) echo "0c" ;;
diag|recovery) echo "27" ;;
*) echo "83" ;;
esac
}

mkfs_run() {
part="$1"; fstype="$2"; label="$3"
case "$fstype" in
ext4|ext3|ext2)
if [ -n "$label" ]; then "mkfs.$fstype" -F -L "$label" "$part" >> "$LOG_FILE" 2>&1
else "mkfs.$fstype" -F "$part" >> "$LOG_FILE" 2>&1; fi ;;
btrfs)
if [ -n "$label" ]; then mkfs.btrfs -f -L "$label" "$part" >> "$LOG_FILE" 2>&1
else mkfs.btrfs -f "$part" >> "$LOG_FILE" 2>&1; fi ;;
f2fs)
if [ -n "$label" ]; then mkfs.f2fs -f -l "$label" "$part" >> "$LOG_FILE" 2>&1
else mkfs.f2fs -f "$part" >> "$LOG_FILE" 2>&1; fi ;;
vfat)
if [ -n "$label" ]; then mkfs.fat -F 32 -n "$label" "$part" >> "$LOG_FILE" 2>&1
else mkfs.fat -F 32 "$part" >> "$LOG_FILE" 2>&1; fi ;;
exfat)
if [ -n "$label" ]; then mkfs.exfat -L "$label" "$part" >> "$LOG_FILE" 2>&1
else mkfs.exfat "$part" >> "$LOG_FILE" 2>&1; fi ;;
ntfs)
if [ -n "$label" ]; then mkfs.ntfs -f -L "$label" "$part" >> "$LOG_FILE" 2>&1
else mkfs.ntfs -f "$part" >> "$LOG_FILE" 2>&1; fi ;;
swap)
if [ -n "$label" ]; then mkswap -L "$label" "$part" >> "$LOG_FILE" 2>&1
else mkswap "$part" >> "$LOG_FILE" 2>&1; fi ;;
none|"") return 0 ;;
*) return 1 ;;
esac
}

run_create_job() {
disk="$1"; layout="$2"; ptype="$3"; fstype="$4"; size_str="$5"; label="$6"; role="$7"
t0=$(date +%s)
write_job "running" 10 "Checking partition table on $disk..." "$t0" 10 ""
log_line "create_part: disk=$disk layout=$layout ptype=$ptype fstype=$fstype size=$size_str label=$label role=$role"

sfd_json=$(sfdisk -J "$disk" 2>/dev/null || true)
if [ -z "$sfd_json" ] || ! echo "$sfd_json" | grep -q '"partitiontable"'; then
lbl="gpt"
[ "$layout" = "mbr" ] && lbl="dos"
write_job "running" 25 "Initializing $lbl partition table on $disk..." "$t0" 8 ""
printf 'label: %s\n' "$lbl" | sfdisk "$disk" >> "$LOG_FILE" 2>&1 || {
write_job "error" 100 "Failed" "$t0" 0 "Failed to initialize partition table on $disk"; return 1;
}
partx -u "$disk" >/dev/null 2>&1 || true
sleep 1
fi

sfd_json=$(sfdisk -J "$disk" 2>/dev/null || true)
cur_lbl=$(echo "$sfd_json" | sed -n 's/.*"label"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)
[ -z "$role" ] && role="$fstype"

write_job "running" 45 "Creating partition on $disk..." "$t0" 6 ""
sz_arg=""
[ -n "$size_str" ] && [ "$size_str" != "max" ] && sz_arg=", $size_str"
if [ "$cur_lbl" = "gpt" ]; then
tguid=$(gpt_type_guid "$role")
start_arg=""
    if [ "${offset_mib:-0}" -gt 0 ] 2>/dev/null; then
        free_start=$(sfdisk -F "$disk" 2>/dev/null | awk '/^[[:space:]]*[0-9]+/ {print $1; exit}')
        [ -n "$free_start" ] && start_arg=$((free_start + offset_mib * 2048))
    fi
    printf '%s,%s, %s\n' "$start_arg" "${sz_arg#, }" "$tguid" | sfdisk --append "$disk" >> "$LOG_FILE" 2>&1
else
thex=$(mbr_type_hex "$role")
if [ "$ptype" = "extended" ]; then
printf ',%s, E\n' "${sz_arg#, }" | sfdisk --append "$disk" >> "$LOG_FILE" 2>&1
else
start_arg=""
            if [ "${offset_mib:-0}" -gt 0 ] 2>/dev/null; then
                free_start=$(sfdisk -F "$disk" 2>/dev/null | awk '/^[[:space:]]*[0-9]+/ {print $1; exit}')
                [ -n "$free_start" ] && start_arg=$((free_start + offset_mib * 2048))
            fi
            printf '%s,%s, %s\n' "$start_arg" "${sz_arg#, }" "$thex" | sfdisk --append "$disk" >> "$LOG_FILE" 2>&1
fi
fi
if [ $? -ne 0 ]; then
write_job "error" 100 "Failed" "$t0" 0 "sfdisk failed creating partition on $disk"; return 1;
fi

partx -u "$disk" >/dev/null 2>&1 || true
sleep 1
new_num=$(sfdisk -J "$disk" 2>/dev/null | grep -o '"node"[[:space:]]*:[[:space:]]*"[^"]*"' | tail -n1 | sed -E 's/.*[^0-9]([0-9]+)"$/\1/')
new_part=$(part_path_for "$disk" "$new_num")

if [ -n "$fstype" ] && [ "$fstype" != "none" ] && [ "$ptype" != "extended" ]; then
write_job "running" 70 "Formatting $new_part as $fstype..." "$t0" 4 ""
mkfs_run "$new_part" "$fstype" "$label" || {
write_job "error" 100 "Failed" "$t0" 0 "mkfs.$fstype failed on $new_part"; return 1;
}
fi

write_job "done" 100 "Completed" "$t0" 0 "Created $new_part ($fstype)"
}

run_format_job() {
part="$1"; fstype="$2"; label="$3"
t0=$(date +%s)
write_job "running" 20 "Unmounting $part if mounted..." "$t0" 6 ""
umount -l "$part" >/dev/null 2>&1 || true
wipefs -a "$part" >> "$LOG_FILE" 2>&1 || true
write_job "running" 55 "Formatting $part as $fstype..." "$t0" 4 ""
if mkfs_run "$part" "$fstype" "$label"; then
write_job "done" 100 "Completed" "$t0" 0 "Formatted $part as $fstype"
else
write_job "error" 100 "Failed" "$t0" 0 "Failed formatting $part as $fstype (check Config tab tools)"
fi
}

run_resize_job() {
    disk="$1"; num="$2"; new_size="$3"; fstype="$4"
    part=$(part_path_for "$disk" "$num")
    t0=$(date +%s)
    log_line "resize_part: disk=$disk num=$num new_size=$new_size fstype=$fstype"

    case "$new_size" in
        -*)
            write_job "running" 20 "Unmounting & checking $fstype filesystem before shrink..." "$t0" 12 ""
            umount -l "$part" >/dev/null 2>&1 || true
            cur_bytes=$(lsblk -b -n -o SIZE "$part" 2>/dev/null | head -n1)
            delta_num=$(echo "$new_size" | sed -E 's/^-([0-9]+).*/\1/')
            delta_unit=$(echo "$new_size" | sed -E 's/^-[0-9]+([KkMmGgTt]?).*/\1/')
            mult=1048576
            case "$delta_unit" in
                K|k) mult=1024 ;;
                M|m|"") mult=1048576 ;;
                G|g) mult=1073741824 ;;
                T|t) mult=1099511627776 ;;
            esac
            tgt_mib=$(( (cur_bytes - delta_num * mult) / 1048576 ))
            [ "$tgt_mib" -lt 64 ] && { write_job "error" 100 "Failed" "$t0" 0 "Target shrink size too small (<64 MiB)"; return 1; }
            case "$fstype" in
                ext4|ext3|ext2)
                    e2fsck -f -y "$part" >> "$LOG_FILE" 2>&1 || true
                    write_job "running" 45 "Shrinking $fstype filesystem to ${tgt_mib}M..." "$t0" 8 ""
                    resize2fs "$part" "${tgt_mib}M" >> "$LOG_FILE" 2>&1 || {
                        write_job "error" 100 "Failed" "$t0" 0 "resize2fs shrink failed on $part"; return 1;
                    } ;;
                ntfs)
                    write_job "running" 45 "Shrinking NTFS filesystem to ${tgt_mib}M..." "$t0" 8 ""
                    ntfsresize -f -f -s "${tgt_mib}M" "$part" >> "$LOG_FILE" 2>&1 || {
                        write_job "error" 100 "Failed" "$t0" 0 "ntfsresize shrink failed on $part"; return 1;
                    } ;;
                *)
                    write_job "error" 100 "Failed" "$t0" 0 "Shrinking is only supported on ext2/3/4 and NTFS"; return 1 ;;
            esac
            write_job "running" 75 "Shrinking partition $part boundary..." "$t0" 4 ""
            echo ", $new_size" | sfdisk --no-reread --force -N "$num" "$disk" >> "$LOG_FILE" 2>&1 || {
                write_job "error" 100 "Failed" "$t0" 0 "sfdisk boundary shrink failed on $part"; return 1;
            }
            partx -u "$disk" >/dev/null 2>&1 || true
            sleep 1
            case "$fstype" in ext4|ext3|ext2) resize2fs "$part" >> "$LOG_FILE" 2>&1 || true ;; esac
            write_job "done" 100 "Completed" "$t0" 0 "Shrunk $part safely to ${tgt_mib} MiB"
            return 0
            ;;
    esac

    write_job "running" 20 "Updating partition $part boundary to $new_size..." "$t0" 10 ""
    if [ "$new_size" = "max" ]; then
        echo ", +" | sfdisk --no-reread --force -N "$num" "$disk" >> "$LOG_FILE" 2>&1
    else
        echo ", $new_size" | sfdisk --no-reread --force -N "$num" "$disk" >> "$LOG_FILE" 2>&1
    fi
    if [ $? -ne 0 ]; then
        write_job "error" 100 "Failed" "$t0" 0 "sfdisk resize failed on $part"; return 1;
    fi
    partx -u "$disk" >/dev/null 2>&1 || true
    sleep 1

    write_job "running" 60 "Resizing $fstype filesystem on $part..." "$t0" 6 ""
    case "$fstype" in
        ext4|ext3|ext2)
            if ! grep -q "^${part} " /proc/mounts; then e2fsck -f -y "$part" >> "$LOG_FILE" 2>&1 || true; fi
            resize2fs "$part" >> "$LOG_FILE" 2>&1 ;;
        btrfs)
            mnt=$(awk -v d="$part" '$1==d{print $2; exit}' /proc/mounts)
            if [ -n "$mnt" ]; then btrfs filesystem resize max "$mnt" >> "$LOG_FILE" 2>&1
            else
                mkdir -p /tmp/volmgr_mnt && mount "$part" /tmp/volmgr_mnt && btrfs filesystem resize max /tmp/volmgr_mnt >> "$LOG_FILE" 2>&1
                umount /tmp/volmgr_mnt >/dev/null 2>&1 || true
            fi ;;
        f2fs)
            resize.f2fs "$part" >> "$LOG_FILE" 2>&1 ;;
        ntfs)
            ntfsresize -f -f "$part" >> "$LOG_FILE" 2>&1 ;;
    esac
    if [ $? -ne 0 ]; then
        write_job "error" 100 "Failed" "$t0" 0 "Filesystem resize failed on $part"; return 1;
    fi
    write_job "done" 100 "Completed" "$t0" 0 "Resized $part successfully"
}

run_delete_job() {
disk="$1"; num="$2"
part=$(part_path_for "$disk" "$num")
t0=$(date +%s)
write_job "running" 30 "Unmounting $part..." "$t0" 4 ""
swapoff "$part" >/dev/null 2>&1 || true
umount -l "$part" >/dev/null 2>&1 || true
wipefs -a "$part" >> "$LOG_FILE" 2>&1 || true
write_job "running" 70 "Deleting partition $num from $disk..." "$t0" 2 ""
if sfdisk --delete "$disk" "$num" >> "$LOG_FILE" 2>&1; then
partx -u "$disk" >/dev/null 2>&1 || true
write_job "done" 100 "Completed" "$t0" 0 "Deleted $part"
else
write_job "error" 100 "Failed" "$t0" 0 "Failed to delete $part"
fi
}

run_pkg_job() {
    action="$1"; pkgs="$2"
    t0=$(date +%s)
    log_line "pkg_action: $action $pkgs"
    if [ "$action" = "add" ]; then
        write_job "running" 15 "Updating package index (apk update)..." "$t0" 15 ""
        apk update >> "$LOG_FILE" 2>&1 || true
        filtered=""
        user_only=""
        for p in $pkgs; do
            case "$p" in
                kmod-fs-ext4) grep -qw ext4 /proc/filesystems && continue ;;
                kmod-fs-btrfs) grep -qw btrfs /proc/filesystems && continue ;;
                kmod-fs-f2fs) grep -qw f2fs /proc/filesystems && continue ;;
                kmod-fs-ntfs3) grep -qw ntfs3 /proc/filesystems && continue ;;
                kmod-fs-exfat) grep -qw exfat /proc/filesystems && continue ;;
                kmod-fs-vfat) grep -qw vfat /proc/filesystems && continue ;;
                kmod-ata-core|kmod-ata-ahci) [ -d /sys/bus/pci/drivers/ahci ] && continue ;;
                kmod-usb-storage) [ -d /sys/bus/usb/drivers/usb-storage ] && continue ;;
            esac
            filtered="$filtered $p"
            case "$p" in kmod-*) ;; *) user_only="$user_only $p" ;; esac
        done
        filtered=$(echo "$filtered" | xargs)
        user_only=$(echo "$user_only" | xargs)
        [ -z "$filtered" ] && { write_job "done" 100 "Completed" "$t0" 0 "Already built into kernel"; return 0; }
        write_job "running" 50 "Installing $filtered..." "$t0" 10 ""
        if apk add $filtered >> "$LOG_FILE" 2>&1; then
            write_job "done" 100 "Completed" "$t0" 0 "Installed: $filtered"
        elif [ -n "$user_only" ] && [ "$user_only" != "$filtered" ] && apk add $user_only >> "$LOG_FILE" 2>&1; then
            write_job "done" 100 "Completed" "$t0" 0 "Installed tools ($user_only); kmod requires kernel build"
        else
            write_job "error" 100 "Failed" "$t0" 0 "apk add failed for: $filtered (see /tmp/volmgr.log)"
        fi
    else
        user_only=""
        for p in $pkgs; do
            case "$p" in kmod-*) ;; *) user_only="$user_only $p" ;; esac
        done
        user_only=$(echo "$user_only" | xargs)
        write_job "running" 50 "Removing $user_only..." "$t0" 6 ""
        if [ -n "$user_only" ] && apk del $user_only >> "$LOG_FILE" 2>&1; then
            write_job "done" 100 "Completed" "$t0" 0 "Removed: $user_only"
        else
            write_job "error" 100 "Failed" "$t0" 0 "apk del failed for: $user_only"
        fi
    fi
}

case "$1" in
list)
json_init
json_add_object "list"; json_close_object
json_add_object "info"; json_add_string "disk" "string"; json_close_object
json_add_object "smart"; json_add_string "disk" "string"; json_close_object
json_add_object "packages"; json_close_object
json_add_object "job_status"; json_close_object
json_add_object "create_part"
json_add_string "disk" "string"; json_add_string "layout" "string"
json_add_string "ptype" "string"; json_add_string "fstype" "string"
json_add_string "size" "string"; json_add_string "label" "string"
json_add_string "role" "string"; json_add_int "offset_mib" 0
json_close_object
json_add_object "format_part"
json_add_string "part" "string"; json_add_string "fstype" "string"; json_add_string "label" "string"
json_close_object
json_add_object "resize_part"
json_add_string "disk" "string"; json_add_int "num" 1
json_add_string "size" "string"; json_add_string "fstype" "string"
json_close_object
json_add_object "delete_part"
json_add_string "disk" "string"; json_add_int "num" 1
json_close_object
json_add_object "set_part_meta"
json_add_string "disk" "string"; json_add_int "num" 1
json_add_string "label" "string"; json_add_string "fstype" "string"
json_add_string "role" "string"; json_add_int "offset_mib" 0; json_add_string "flags" "string"
json_close_object
json_add_object "mount_action"
json_add_string "action" "string"; json_add_string "part" "string"; json_add_string "target" "string"
json_close_object
json_add_object "pkg_action"
json_add_string "action" "string"; json_add_string "packages" "string"
json_close_object
json_dump
;;
call)
read -r input
json_load "$input"
case "$2" in
list)
lsblk_json=$(lsblk -J -b -o NAME,KNAME,PKNAME,TYPE,SIZE,FSTYPE,LABEL,UUID,PARTTYPE,PARTTYPENAME,PARTFLAGS,MOUNTPOINT,MODEL,SERIAL,ROTA,TRAN 2>/dev/null || echo '{"blockdevices":[]}')
printf '{"lsblk":%s}\n' "$lsblk_json"
;;
info)
json_get_var disk disk
is_safe_dev "$disk" || { echo '{"error":"Invalid device"}'; exit 0; }
bn=$(basename "$disk")
sfd=$(sfdisk -J "$disk" 2>/dev/null || echo '{}')
free_out=$(sfdisk -F "$disk" 2>/dev/null || true)
rota=$(cat "/sys/block/$bn/queue/rotational" 2>/dev/null || echo "1")
lbs=$(cat "/sys/block/$bn/queue/logical_block_size" 2>/dev/null || echo "512")
pbs=$(cat "/sys/block/$bn/queue/physical_block_size" 2>/dev/null || echo "512")
sched=$(cat "/sys/block/$bn/queue/scheduler" 2>/dev/null || echo "")
usb_spd=""
if readlink -f "/sys/block/$bn" 2>/dev/null | grep -q "/usb"; then
usb_dir=$(readlink -f "/sys/block/$bn" | sed -E 's#(/usb[0-9]+/[0-9-]+).*#\1#')
[ -f "$usb_dir/speed" ] && usb_spd="$(cat "$usb_dir/speed") Mbps"
fi
json_init
json_add_string "disk" "$disk"
json_add_string "rotational" "$rota"
json_add_string "logical_bs" "$lbs"
json_add_string "physical_bs" "$pbs"
json_add_string "scheduler" "$sched"
json_add_string "usb_speed" "$usb_spd"
json_add_string "free_raw" "$free_out"
json_dump | sed "s/}\$/,\"sfdisk\":${sfd}}/"
;;
smart)
json_get_var disk disk
is_safe_dev "$disk" || { echo '{"error":"Invalid device"}'; exit 0; }
if ! command -v smartctl >/dev/null 2>&1; then
echo '{"installed":false}'
exit 0
fi
out=$(smartctl -x -j "$disk" 2>/dev/null || true)
if ! echo "$out" | grep -q '"device"'; then
out=$(smartctl -x -j -d sat "$disk" 2>/dev/null || echo '{}')
fi
printf '{"installed":true,"smart":%s}\n' "$out"
;;
packages)
                if command -v apk >/dev/null 2>&1; then
                    plist=$(apk list --installed 2>/dev/null | awk '{print $1}')
                else
                    plist=$(opkg list-installed 2>/dev/null | awk '{print $1}')
                fi
                kfs=$(awk '{print $NF}' /proc/filesystems 2>/dev/null | tr '\n' ' ')
                kbuses=$(ls /sys/bus/scsi/drivers/sd /sys/bus/usb/drivers/usb-storage /sys/bus/pci/drivers/ahci 2>/dev/null | tr '\n' ' ')
                json_init
                json_add_string "installed" "$plist"
                json_add_string "kfs" "$kfs"
                json_add_string "kbuses" "$kbuses"
                json_dump
                ;;
            job_status)
if [ -f "$JOB_FILE" ]; then cat "$JOB_FILE"; else echo '{"state":"idle","pct":0}'; fi
;;
create_part)
json_get_vars disk layout ptype fstype size label role offset_mib
is_safe_dev "$disk" || { echo '{"error":"Protected or invalid device"}'; exit 0; }
run_create_job "$disk" "$layout" "$ptype" "$fstype" "$size" "$label" "$role" "$offset_mib" >/dev/null 2>&1 &
echo '{"started":true}'
;;
format_part)
json_get_vars part fstype label
is_safe_dev "$part" || { echo '{"error":"Protected or invalid partition"}'; exit 0; }
run_format_job "$part" "$fstype" "$label" >/dev/null 2>&1 &
echo '{"started":true}'
;;
resize_part)
json_get_vars disk num size fstype
is_safe_dev "$disk" || { echo '{"error":"Protected or invalid device"}'; exit 0; }
run_resize_job "$disk" "$num" "$size" "$fstype" >/dev/null 2>&1 &
echo '{"started":true}'
;;
delete_part)
json_get_vars disk num
is_safe_dev "$disk" || { echo '{"error":"Protected or invalid device"}'; exit 0; }
run_delete_job "$disk" "$num" >/dev/null 2>&1 &
echo '{"started":true}'
;;
set_part_meta)
json_get_vars disk num label fstype role flags
is_safe_dev "$disk" || { echo '{"error":"Protected or invalid device"}'; exit 0; }
part=$(part_path_for "$disk" "$num")
cur_lbl=$(sfdisk -J "$disk" 2>/dev/null | sed -n 's/.*"label"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)
if [ -n "$role" ]; then
if [ "$cur_lbl" = "gpt" ]; then
sfdisk --part-type "$disk" "$num" "$(gpt_type_guid "$role")" >> "$LOG_FILE" 2>&1 || true
else
sfdisk --part-type "$disk" "$num" "$(mbr_type_hex "$role")" >> "$LOG_FILE" 2>&1 || true
fi
fi
if [ "$cur_lbl" = "gpt" ]; then
attrs=""
echo "$flags" | grep -qw "hidden" && attrs="${attrs},62"
echo "$flags" | grep -qw "legacy_boot" && attrs="${attrs},2"
echo "$flags" | grep -qw "no_auto" && attrs="${attrs},63"
sfdisk --part-attrs "$disk" "$num" "${attrs#,}" >> "$LOG_FILE" 2>&1 || true
else
if echo "$flags" | grep -qw "boot"; then
sfdisk --activate "$disk" "$num" >> "$LOG_FILE" 2>&1 || true
fi
fi
if [ -n "$label" ]; then
case "$fstype" in
ext4|ext3|ext2) tune2fs -L "$label" "$part" >> "$LOG_FILE" 2>&1 || true ;;
btrfs) btrfs filesystem label "$part" "$label" >> "$LOG_FILE" 2>&1 || true ;;
f2fs) sfdisk --part-label "$disk" "$num" "$label" >> "$LOG_FILE" 2>&1 || true ;;
vfat) fatlabel "$part" "$label" >> "$LOG_FILE" 2>&1 || true ;;
ntfs) ntfslabel "$part" "$label" >> "$LOG_FILE" 2>&1 || true ;;
esac
fi
partx -u "$disk" >/dev/null 2>&1 || true
echo '{"ok":true}'
;;
mount_action)
json_get_vars action part target
case "$action" in
mount)
is_safe_dev "$part" || { echo '{"error":"Invalid partition"}'; exit 0; }
[ -z "$target" ] && target="/mnt/$(basename "$part")"
mkdir -p "$target"
if mount "$part" "$target" >> "$LOG_FILE" 2>&1; then
echo '{"ok":true}'
else
echo '{"error":"Mount failed (check filesystem driver in Config tab)"}'
fi
;;
umount)
is_safe_dev "$part" || { echo '{"error":"Invalid partition"}'; exit 0; }
if umount "$part" >> "$LOG_FILE" 2>&1 || umount -l "$part" >> "$LOG_FILE" 2>&1; then
echo '{"ok":true}'
else
echo '{"error":"Unmount failed (device busy)"}'
fi
;;
block_mount)
block mount >> "$LOG_FILE" 2>&1 || true
echo '{"ok":true}'
;;
esac
;;
pkg_action)
json_get_vars action packages
case "$action" in
add|del) ;;
*) echo '{"error":"Invalid action"}'; exit 0 ;;
esac
run_pkg_job "$action" "$packages" >/dev/null 2>&1 &
echo '{"started":true}'
;;
esac
;;
esac
