                    sfdisk --no-reread --part-attrs "$disk" "$num" "${attrs:--}" >> "$LOG_FILE" 2>&1 || true
                else
                    if [ -n "$role" ]; then
                        sfdisk --no-reread --part-type "$disk" "$num" "$(mbr_type_hex "$role")" >> "$LOG_FILE" 2>&1 || true
                    fi
                    case ",$flags," in
                        *,hidden,*)
                            cur_t=$(sfdisk --part-type "$disk" "$num" 2>/dev/null | tr 'A-F' 'a-f')
                            case "$cur_t" in
