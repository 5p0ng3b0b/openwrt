                                *) sfdisk --no-reread --part-type "$disk" "$num" "17" >> "$LOG_FILE" 2>&1 || true ;;
                            esac ;;
                        *)
                            cur_t=$(sfdisk --part-type "$disk" "$num" 2>/dev/null | tr 'A-F' 'a-f')
                            case "$cur_t" in
                                1b|1c) sfdisk --no-reread --part-type "$disk" "$num" "0c" >> "$LOG_FILE" 2>&1 || true ;;
                                17) sfdisk --no-reread --part-type "$disk" "$num" "83" >> "$LOG_FILE" 2>&1 || true ;;
                            esac ;;
                    esac
                    is_act=$(fdisk -l "$disk" 2>/dev/null | awk -v p="$part" '$1==p && $2=="*" {print 1}')
                    case ",$flags," in
                        *,boot,*) [ -z "$is_act" ] && printf 'a\n%s\nw\n' "$num" | fdisk "$disk" >> "$LOG_FILE" 2>&1 || true ;;
                        *) [ -n "$is_act" ] && printf 'a\n%s\nw\n' "$num" | fdisk "$disk" >> "$LOG_FILE" 2>&1 || true ;;
