                        btrfs) btrfs filesystem label "$part" "$label" >> "$LOG_FILE" 2>&1 || true ;;
                        vfat|fat32) fatlabel "$part" "$label" >> "$LOG_FILE" 2>&1 || true ;;
                        ntfs) ntfslabel "$part" "$label" >> "$LOG_FILE" 2>&1 || true ;;
