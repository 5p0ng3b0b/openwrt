#!/bin/sh
. /usr/share/libubox/jshn.sh

JOB_FILE="/tmp/volmgr-job.json"
LOG_FILE="/tmp/volmgr.log"

log_line() {
printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$LOG_FILE"
}

is_safe_dev() {
dev="$1"
[ -b "$dev" ] || return 1
bn=$(basename "$dev")
case "$bn" in
mtd*|ubi*|loop*|ram*|zram*|mmcblk0*) return 1 ;;
sd[a-z]|sd[a-z][0-9]*|nvme[0-9]*n[0-9]*|mmcblk[1-9]*|vd[a-z]*|md[0-9]*) ;;
*) return 1 ;;
esac
if awk -v d="$dev" '$1==d && ($2=="/" || $2=="/overlay" || $2=="/rom") {found=1} END{exit !found}' /proc/mounts 2>/dev/null; then
return 1
fi
return 0
}

write_job() {
state="$1"; pct="$2"; step="$3"; start_ts="$4"; eta="$5"; msg="$6"
now=$(date +%s)
elapsed=$((now - start_ts))
json_init
json_add_string "state" "$state"
json_add_int "pct" "$pct"
json_add_string "step" "$step"
json_add_int "elapsed" "$elapsed"
json_add_int "eta" "$eta"
json_add_string "message" "$msg"
json_dump > "$JOB_FILE"
}

part_path_for() {
disk="$1"; num="$2"
case "$(basename "$disk")" in
*[0-9]) echo "${disk}p${num}" ;;
*) echo "${disk}${num}" ;;
esac
}

gpt_type_guid() {
    case "$1" in
        efi|esp) echo "C12A7328-F81F-11D2-BA4B-00A0C93EC93B" ;;
        bios) echo "21686148-6449-6E6F-744E-656564454649" ;;
        swap) echo "0657FD6D-A496-4300-B1E5-22E5122CF098" ;;
        raid|md) echo "A19D880F-05FC-4D3B-A006-743F0F84911E" ;;
        lvm) echo "E6D6D379-F507-44C2-A23C-238F2A3DF928" ;;
        home) echo "933AC7E1-2EB4-4F13-B844-0E14E2AEF915" ;;
        luks) echo "CA7D7CCB-63ED-4C53-861C-1742536059CC" ;;
        dmcrypt) echo "7FFEC5C9-2D00-49B7-8941-3EA10A5586B7" ;;
        zfs) echo "516E7CBA-6ECF-11D6-8FF8-00022D09712B" ;;
        apfs) echo "7C3457EF-0000-11AA-AA11-00306543ECAC" ;;
        hfs) echo "48465300-0000-11AA-AA11-00306543ECAC" ;;
        msr) echo "E3C9E316-0B5C-4DB8-817D-F92DF00215AE" ;;
        ldm) echo "AF9B60A0-1431-4F62-BC68-3311714A69AD" ;;
        ntfs|exfat|vfat|fat32|msftdata) echo "EBD0A0A2-B9E5-4433-87C0-68B6B72699C7" ;;
        diag|recovery) echo "DE94BBA4-06D1-4D40-A16A-BFD50179D6AC" ;;
        *-*-*-*-*) echo "$1" ;;
        *) echo "0FC63DAF-8483-4772-8E79-3D69D8477DE4" ;;
    esac
}

mbr_type_hex() {
    case "$1" in
        efi|esp) echo "ef" ;;
        bios) echo "da" ;;
        swap) echo "82" ;;
        raid|md) echo "fd" ;;
        lvm) echo "8e" ;;
        zfs) echo "bf" ;;
        apfs|hfs) echo "af" ;;
        msr) echo "0c" ;;
        ldm) echo "42" ;;
        ntfs|exfat|msftdata) echo "07" ;;
        vfat|fat32) echo "0c" ;;
        diag|recovery) echo "27" ;;
        0x*|0X*) echo "${1#0?}" ;;
        [0-9a-fA-F][0-9a-fA-F]) echo "$1" ;;
        *) echo "83" ;;
    esac
}

mkfs_run() {
part="$1"; fstype="$2"; label="$3"
case "$fstype" in
ext4|ext3|ext2)
if [ -n "$label" ]; then "mkfs.$fstype" -F -L "$label" "$part" >> "$LOG_FILE" 2>&1
else "mkfs.$fstype" -F "$part" >> "$LOG_FILE" 2>&1; fi ;;
btrfs)
if [ -n "$label" ]; then mkfs.btrfs -f -L "$label" "$part" >> "$LOG_FILE" 2>&1
else mkfs.btrfs -f "$part" >> "$LOG_FILE" 2>&1; fi ;;
f2fs)
if [ -n "$label" ]; then mkfs.f2fs -f -l "$label" "$part" >> "$LOG_FILE" 2>&1
else mkfs.f2fs -f "$part" >> "$LOG_FILE" 2>&1; fi ;;
vfat)
if [ -n "$label" ]; then mkfs.fat -F 32 -n "$label" "$part" >> "$LOG_FILE" 2>&1
else mkfs.fat -F 32 "$part" >> "$LOG_FILE" 2>&1; fi ;;
exfat)
if [ -n "$label" ]; then mkfs.exfat -L "$label" "$part" >> "$LOG_FILE" 2>&1
else mkfs.exfat "$part" >> "$LOG_FILE" 2>&1; fi ;;
ntfs)
if [ -n "$label" ]; then mkfs.ntfs -f -L "$label" "$part" >> "$LOG_FILE" 2>&1
else mkfs.ntfs -f "$part" >> "$LOG_FILE" 2>&1; fi ;;
swap)
if [ -n "$label" ]; then mkswap -L "$label" "$part" >> "$LOG_FILE" 2>&1
else mkswap "$part" >> "$LOG_FILE" 2>&1; fi ;;
none|"") return 0 ;;
*) return 1 ;;
esac
}

run_create_job() {
    disk="$1"; layout="$2"; ptype="$3"; fstype="$4"; size_str="$5"; label="$6"; role="$7"; offset_mib="${8:-0}"
    t0=$(date +%s)
    write_job "running" 10 "Checking partition table on $disk..." "$t0" 10 ""
    log_line "create_part: disk=$disk layout=$layout ptype=$ptype fstype=$fstype size=$size_str label=$label role=$role offset_mib=$offset_mib"

    has_parts=$(lsblk -n -r -o TYPE "$disk" 2>/dev/null | grep -cw part || true)
    cur_lbl=$(fdisk -l "$disk" 2>/dev/null | sed -n 's/^Disklabel type:[[:space:]]*//p' | head -n1)
    if [ "${has_parts:-0}" -eq 0 ] && [ -z "$cur_lbl" ]; then
        lbl="gpt"
        [ "$layout" = "mbr" ] && lbl="dos"
        write_job "running" 25 "Initializing $lbl partition table on $disk..." "$t0" 8 ""
        printf 'label: %s\n' "$lbl" | sfdisk --no-reread "$disk" >> "$LOG_FILE" 2>&1 || {
            write_job "error" 100 "Failed" "$t0" 0 "Failed to initialize partition table on $disk (see /tmp/volmgr.log)"; return 1;
        }
        partx -u "$disk" >/dev/null 2>&1 || true
        sleep 1
        cur_lbl="$lbl"
    fi
    [ -z "$cur_lbl" ] && [ "$layout" = "gpt" ] && cur_lbl="gpt"
    [ -z "$cur_lbl" ] && cur_lbl="dos"
    [ -z "$role" ] && role="$fstype"

    write_job "running" 45 "Creating partition on $disk..." "$t0" 6 ""
    sz_arg=""
    [ -n "$size_str" ] && [ "$size_str" != "max" ] && sz_arg="$size_str"
    start_arg=""
    if [ "${offset_mib:-0}" -gt 0 ] 2>/dev/null; then
        last_end=$(fdisk -l -u=sectors "$disk" 2>/dev/null | awk -v d="$disk" '$1 ~ "^"d"[0-9p]" {end=$3} END{print end}')
        [ -n "$last_end" ] && start_arg=$((last_end + 1 + offset_mib * 2048))
    fi

    if [ "$cur_lbl" = "gpt" ]; then
        tguid=$(gpt_type_guid "$role")
        printf '%s,%s,%s\n' "$start_arg" "$sz_arg" "$tguid" | sfdisk --no-reread --force --append "$disk" >> "$LOG_FILE" 2>&1
    else
        thex=$(mbr_type_hex "$role")
        if [ "$ptype" = "extended" ]; then
            printf '%s,%s,E\n' "$start_arg" "$sz_arg" | sfdisk --no-reread --force --append "$disk" >> "$LOG_FILE" 2>&1
        else
            printf '%s,%s,%s\n' "$start_arg" "$sz_arg" "$thex" | sfdisk --no-reread --force --append "$disk" >> "$LOG_FILE" 2>&1
        fi
    fi
    if [ $? -ne 0 ]; then
        write_job "error" 100 "Failed" "$t0" 0 "sfdisk failed creating partition on $disk (see /tmp/volmgr.log)"; return 1;
    fi

    partx -u "$disk" >/dev/null 2>&1 || true
    sleep 1
    new_part=$(lsblk -n -r -o NAME,TYPE "$disk" 2>/dev/null | awk '$2=="part"{print "/dev/"$1}' | tail -n1)

    if [ -n "$new_part" ] && [ -n "$fstype" ] && [ "$fstype" != "none" ] && [ "$ptype" != "extended" ]; then
        write_job "running" 70 "Formatting $new_part as $fstype..." "$t0" 4 ""
        mkfs_run "$new_part" "$fstype" "$label" || {
            write_job "error" 100 "Failed" "$t0" 0 "mkfs.$fstype failed on $new_part (see /tmp/volmgr.log)"; return 1;
        }
    fi

    write_job "done" 100 "Completed" "$t0" 0 "Created $new_part ($fstype)"
}

run_format_job() {
part="$1"; fstype="$2"; label="$3"
t0=$(date +%s)
write_job "running" 20 "Unmounting $part if mounted..." "$t0" 6 ""
umount -l "$part" >/dev/null 2>&1 || true
wipefs -a "$part" >> "$LOG_FILE" 2>&1 || true
write_job "running" 55 "Formatting $part as $fstype..." "$t0" 4 ""
if mkfs_run "$part" "$fstype" "$label"; then
write_job "done" 100 "Completed" "$t0" 0 "Formatted $part as $fstype"
else
write_job "error" 100 "Failed" "$t0" 0 "Failed formatting $part as $fstype (check Config tab tools)"
fi
}

run_resize_job() {
    disk="$1"; num="$2"; new_size="$3"; fstype="$4"
    part=$(part_path_for "$disk" "$num")
    t0=$(date +%s)
    log_line "resize_part: disk=$disk num=$num new_size=$new_size fstype=$fstype"

    case "$new_size" in
        -*)
            write_job "running" 20 "Unmounting & checking $fstype filesystem before shrink..." "$t0" 12 ""
            umount -l "$part" >/dev/null 2>&1 || true
            cur_bytes=$(lsblk -b -n -o SIZE "$part" 2>/dev/null | head -n1)
            delta_num=$(echo "$new_size" | sed -E 's/^-([0-9]+).*/\1/')
            delta_unit=$(echo "$new_size" | sed -E 's/^-[0-9]+([KkMmGgTt]?).*/\1/')
            mult=1048576
            case "$delta_unit" in
                K|k) mult=1024 ;;
                M|m|"") mult=1048576 ;;
                G|g) mult=1073741824 ;;
                T|t) mult=1099511627776 ;;
            esac
            tgt_mib=$(( (cur_bytes - delta_num * mult) / 1048576 ))
            [ "$tgt_mib" -lt 64 ] && { write_job "error" 100 "Failed" "$t0" 0 "Target shrink size too small (<64 MiB)"; return 1; }
            case "$fstype" in
                ext4|ext3|ext2)
                    e2fsck -f -y "$part" >> "$LOG_FILE" 2>&1 || true
                    write_job "running" 45 "Shrinking $fstype filesystem to ${tgt_mib}M..." "$t0" 8 ""
                    resize2fs "$part" "${tgt_mib}M" >> "$LOG_FILE" 2>&1 || {
                        write_job "error" 100 "Failed" "$t0" 0 "resize2fs shrink failed on $part"; return 1;
                    } ;;
                ntfs)
                    write_job "running" 45 "Shrinking NTFS filesystem to ${tgt_mib}M..." "$t0" 8 ""
                    ntfsresize -f -f -s "${tgt_mib}M" "$part" >> "$LOG_FILE" 2>&1 || {
                        write_job "error" 100 "Failed" "$t0" 0 "ntfsresize shrink failed on $part"; return 1;
                    } ;;
                *)
                    write_job "error" 100 "Failed" "$t0" 0 "Shrinking is only supported on ext2/3/4 and NTFS"; return 1 ;;
            esac
            write_job "running" 75 "Shrinking partition $part boundary..." "$t0" 4 ""
            echo ", $new_size" | sfdisk --no-reread --force -N "$num" "$disk" >> "$LOG_FILE" 2>&1 || {
                write_job "error" 100 "Failed" "$t0" 0 "sfdisk boundary shrink failed on $part"; return 1;
            }
            partx -u "$disk" >/dev/null 2>&1 || true
            sleep 1
            case "$fstype" in ext4|ext3|ext2) resize2fs "$part" >> "$LOG_FILE" 2>&1 || true ;; esac
            write_job "done" 100 "Completed" "$t0" 0 "Shrunk $part safely to ${tgt_mib} MiB"
            return 0
            ;;
    esac

    write_job "running" 20 "Updating partition $part boundary to $new_size..." "$t0" 10 ""
    if [ "$new_size" = "max" ]; then
        echo ", +" | sfdisk --no-reread --force -N "$num" "$disk" >> "$LOG_FILE" 2>&1
    else
        echo ", $new_size" | sfdisk --no-reread --force -N "$num" "$disk" >> "$LOG_FILE" 2>&1
    fi
    if [ $? -ne 0 ]; then
        write_job "error" 100 "Failed" "$t0" 0 "sfdisk resize failed on $part"; return 1;
    fi
    partx -u "$disk" >/dev/null 2>&1 || true
    sleep 1

    write_job "running" 60 "Resizing $fstype filesystem on $part..." "$t0" 6 ""
    case "$fstype" in
        ext4|ext3|ext2)
            if ! grep -q "^${part} " /proc/mounts; then e2fsck -f -y "$part" >> "$LOG_FILE" 2>&1 || true; fi
            resize2fs "$part" >> "$LOG_FILE" 2>&1 ;;
        btrfs)
            mnt=$(awk -v d="$part" '$1==d{print $2; exit}' /proc/mounts)
            if [ -n "$mnt" ]; then btrfs filesystem resize max "$mnt" >> "$LOG_FILE" 2>&1
            else
                mkdir -p /tmp/volmgr_mnt && mount "$part" /tmp/volmgr_mnt && btrfs filesystem resize max /tmp/volmgr_mnt >> "$LOG_FILE" 2>&1
                umount /tmp/volmgr_mnt >/dev/null 2>&1 || true
            fi ;;
        f2fs)
            resize.f2fs "$part" >> "$LOG_FILE" 2>&1 ;;
        ntfs)
            ntfsresize -f -f "$part" >> "$LOG_FILE" 2>&1 ;;
    esac
    if [ $? -ne 0 ]; then
        write_job "error" 100 "Failed" "$t0" 0 "Filesystem resize failed on $part"; return 1;
    fi
    write_job "done" 100 "Completed" "$t0" 0 "Resized $part successfully"
}

run_move_job() {
    disk="$1"; num="$2"; delta_mib="$3"; fstype="$4"
    part=$(part_path_for "$disk" "$num")
    t0=$(date +%s)
    log_line "move_part: disk=$disk num=$num delta_mib=$delta_mib fstype=$fstype"
    write_job "running" 15 "Unmounting & checking $part before move..." "$t0" 20 ""
    swapoff "$part" >/dev/null 2>&1 || true
    umount -l "$part" >/dev/null 2>&1 || true
    case "$fstype" in ext4|ext3|ext2) e2fsck -f -y "$part" >> "$LOG_FILE" 2>&1 || true ;; esac

    cur_start=$(fdisk -l -u=sectors "$disk" 2>/dev/null | awk -v p="$part" '$1==p {print $2; exit}')
    [ -z "$cur_start" ] && { write_job "error" 100 "Failed" "$t0" 0 "Could not determine start sector of $part"; return 1; }
    new_start=$((cur_start + delta_mib * 2048))
    [ "$new_start" -lt 2048 ] && new_start=2048

    bname=$(basename "$disk")
    part_secs=$(( $(lsblk -b -n -o SIZE "$part" 2>/dev/null | head -n1 || echo 1073741824) / 512 ))
    [ "${part_secs:-0}" -le 0 ] && part_secs=2097152
    s0=$(awk -v d="$bname" '$3==d {print $6; exit}' /proc/diskstats 2>/dev/null || echo 0)
    echo "${new_start}," | sfdisk --no-reread --force --move-data "$disk" -N "$num" >> "$LOG_FILE" 2>&1 &
    mv_pid=$!
    while kill -0 "$mv_pid" 2>/dev/null; do
        el=$(( $(date +%s) - t0 ))
        s_now=$(awk -v d="$bname" '$3==d {print $6; exit}' /proc/diskstats 2>/dev/null || echo "$s0")
        moved=$(( s_now - s0 ))
        if [ "${moved:-0}" -gt 2048 ] && [ "$el" -gt 0 ]; then
            pct=$(( 15 + (moved * 82) / part_secs ))
            [ "$pct" -gt 97 ] && pct=97
            rem=$(( (el * (part_secs - moved)) / moved ))
            [ "$rem" -lt 1 ] && rem=1
        else
            pct=15
            rem=0
        fi
        write_job "running" "$pct" "Relocating data blocks for $part (do not power off)..." "$t0" "$rem" ""
        sleep 2
    done
    if wait "$mv_pid"; then
        partx -u "$disk" >/dev/null 2>&1 || true
        sleep 1
        write_job "done" 100 "Completed" "$t0" 0 "Moved $part cleanly"
    else
        write_job "error" 100 "Failed" "$t0" 0 "sfdisk --move-data failed on $part (see /tmp/volmgr.log)"
    fi
}

run_delete_job() {
disk="$1"; num="$2"
part=$(part_path_for "$disk" "$num")
t0=$(date +%s)
write_job "running" 30 "Unmounting $part..." "$t0" 4 ""
swapoff "$part" >/dev/null 2>&1 || true
umount -l "$part" >/dev/null 2>&1 || true
wipefs -a "$part" >> "$LOG_FILE" 2>&1 || true
write_job "running" 70 "Deleting partition $num from $disk..." "$t0" 2 ""
if sfdisk --delete "$disk" "$num" >> "$LOG_FILE" 2>&1; then
partx -u "$disk" >/dev/null 2>&1 || true
write_job "done" 100 "Completed" "$t0" 0 "Deleted $part"
else
write_job "error" 100 "Failed" "$t0" 0 "Failed to delete $part"
fi
}

run_pkg_job() {
    action="$1"; pkgs="$2"
    t0=$(date +%s)
    log_line "pkg_action: $action $pkgs"
    if [ "$action" = "add" ]; then
        write_job "running" 15 "Updating package index (apk update)..." "$t0" 15 ""
        apk update >> "$LOG_FILE" 2>&1 || true
        filtered=""
        user_only=""
        kver=$(uname -r)
        for p in $pkgs; do
            case "$p" in
                kmod-fs-ext2|kmod-fs-ext4)
                    if grep -qw ext4 /proc/filesystems || find "/lib/modules/$kver" -name 'ext4.ko' 2>/dev/null | grep -q .; then
                        modprobe ext4 >> "$LOG_FILE" 2>&1 || true
                        continue
                    fi ;;
                kmod-fs-btrfs)
                    if grep -qw btrfs /proc/filesystems || find "/lib/modules/$kver" -name 'btrfs.ko' 2>/dev/null | grep -q .; then
                        modprobe btrfs >> "$LOG_FILE" 2>&1 || true
                        continue
                    fi ;;
                kmod-fs-f2fs)
                    if grep -qw f2fs /proc/filesystems || find "/lib/modules/$kver" -name 'f2fs.ko' 2>/dev/null | grep -q .; then
                        modprobe f2fs >> "$LOG_FILE" 2>&1 || true
                        continue
                    fi ;;
                kmod-fs-ntfs3)
                    if grep -qw ntfs3 /proc/filesystems || find "/lib/modules/$kver" -name 'ntfs3.ko' 2>/dev/null | grep -q .; then
                        modprobe ntfs3 >> "$LOG_FILE" 2>&1 || true
                        continue
                    fi ;;
                kmod-fs-exfat)
                    if grep -qw exfat /proc/filesystems || find "/lib/modules/$kver" -name 'exfat.ko' 2>/dev/null | grep -q .; then
                        modprobe exfat >> "$LOG_FILE" 2>&1 || true
                        continue
                    fi ;;
                kmod-fs-vfat)
                    if grep -qw vfat /proc/filesystems || find "/lib/modules/$kver" -name 'vfat.ko' 2>/dev/null | grep -q .; then
                        modprobe vfat >> "$LOG_FILE" 2>&1 || true
                        continue
                    fi ;;
                kmod-ata-core|kmod-ata-ahci) [ -d /sys/bus/pci/drivers/ahci ] && continue ;;
                kmod-usb-storage) [ -d /sys/bus/usb/drivers/usb-storage ] && continue ;;
            esac
            filtered="$filtered $p"
            case "$p" in kmod-*) ;; *) user_only="$user_only $p" ;; esac
        done
        filtered=$(echo "$filtered" | xargs)
        user_only=$(echo "$user_only" | xargs)
        [ -z "$filtered" ] && { write_job "done" 100 "Completed" "$t0" 0 "Already built into kernel"; return 0; }
        write_job "running" 50 "Installing $filtered..." "$t0" 10 ""
        if apk add $filtered >> "$LOG_FILE" 2>&1; then
            write_job "done" 100 "Completed" "$t0" 0 "Installed: $filtered"
        elif [ -n "$user_only" ]; then
            ok_u=""
            for _u in $user_only; do apk add "$_u" >> "$LOG_FILE" 2>&1 && ok_u="$ok_u $_u"; done
            ok_u=$(echo "$ok_u" | xargs)
            if [ -n "$ok_u" ]; then
                write_job "done" 100 "Completed" "$t0" 0 "Installed tools ($ok_u); kmod requires kernel build"
            else
                if tail -n 10 "$LOG_FILE" | grep -q "kmod-"; then
                missing_km=$(tail -n 10 "$LOG_FILE" | sed -n 's/.*\(kmod-[a-z0-9-]*\).*/\1/p' | sort -u | tr '\n' ' ' | xargs)
                write_job "error" 100 "Kernel Module Missing" "$t0" 0 "Requires $missing_km — not built into this firmware image (enable in make menuconfig)."
            else
                write_job "error" 100 "Failed" "$t0" 0 "apk add failed for: $filtered (see /tmp/volmgr.log)"
            fi
            fi
        else
            write_job "error" 100 "Failed" "$t0" 0 "apk add failed for: $filtered (see /tmp/volmgr.log)"
        fi
    else
        user_only=""
        for p in $pkgs; do
            case "$p" in kmod-*) ;; *) user_only="$user_only $p" ;; esac
        done
        user_only=$(echo "$user_only" | xargs)
        write_job "running" 50 "Removing $user_only..." "$t0" 6 ""
        if [ -n "$user_only" ] && apk del $user_only >> "$LOG_FILE" 2>&1; then
            write_job "done" 100 "Completed" "$t0" 0 "Removed: $user_only"
        else
            write_job "error" 100 "Failed" "$t0" 0 "apk del failed for: $user_only"
        fi
    fi
}

