
config general 'general'
	option enabled '1'

config page
	option bmp 'logo.bmp'
	option row1 '{hostname} * {ip} * {date} {time_sec}'

config page
	option row0 '{page} {hostname} '
	option row6 'CPU:{cpu_load}% {cpu_temp}C Fan:{fan}'
	option row7 'Flash:{flash}'
	option row5 'RAM: {ram}'
	option row4 'Up: {uptime}'
	option row2 '{date}   {time_sec}'

config page
	option row0 '{page} Storage & RAID'
	option row2 'SATA Bays: {sata}'
	option row4 'RAID: {raid}'
	option row6 'Flash:{flash}'

config page
	option row0 '{page} Network & Load'
	option row6 'RX:{rx_rate} TX:{tx_rate}'
	option row7 'Load: {load}'
	option row1 'IP:{ip}'
	option row5 'eth0:{eth0_speed} eth1:{eth1_speed}'

